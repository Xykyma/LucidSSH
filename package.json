    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.4",
    "i18next-fs-backend": "^2.6.6",
    "keytar": "^7.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "ssh2": "^1.17.0"
