{
  "name": "lucidssh",
  "productName": "LucidSSH",
  "version": "1.0.0",
  "description": "LucidSSH for Windows — SSH-клиент с защитой от опасных команд и объяснением ошибок",
  "main": "out/main/index.js",
  "private": true,
  "author": "LucidSSH",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:test": "npm rebuild better-sqlite3 keytar",
    "rebuild:app": "electron-rebuild -f -w better-sqlite3,keytar"
  },
  "dependencies": {
