{
  "name": "lucidssh",
  "productName": "LucidSSH",
  "version": "1.0.3",
  "description": "LucidSSH for Windows — SSH-клиент с защитой от опасных команд и объяснением ошибок",
  "main": "out/main/index.js",
  "desktopName": "LucidSSH",
  "homepage": "https://github.com/Xykyma/LucidSSH",
  "private": true,
  "author": {
    "name": "LucidSSH",
    "email": "Xykyma@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:test": "npm rebuild better-sqlite3 keytar",
    "rebuild:app": "electron-rebuild -f -w better-sqlite3,keytar"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "i18next": "^26.3.4",
    "i18next-fs-backend": "^2.6.10",
    "keytar": "^7.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.8",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  }
}
